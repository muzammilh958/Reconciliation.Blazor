@using Microsoft.AspNetCore.Components.Authorization
@using Reconciliation.Blazor.Layout.Partials

@inject JwtAuthStateProvider AuthStateProvider
@inject TokenServices TokenService
@inherits LayoutComponentBase

@inject NavigationManager Navigation

<Topbar/>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.Prefix">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="UserList">
                <span class="bi bi-people-fill fs-5 "></span>User Management
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/batch/list">
                <span class="bi bi-people-fill fs-5 "></span>Batch Management
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard/profile">
                        <span class="oi oi-person" aria-hidden="true"></span> Profile
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="authContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="dashboard/admin">
                            <span class="oi oi-lock-locked" aria-hidden="true"></span> Admin Panel
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="OnLogout">
                        <span class="oi oi-account-logout" aria-hidden="true"></span> Logout
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/">
                        <span class="oi oi-account-login" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>




@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    [Inject]
    private NavigationManager? NavigationManagers { get; set; }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task OnLogout()
    {
        await AuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/");
    }
}
