@page "/payment/add"

@inject IPaymentService PaymentService
@inject NavigationManager Nav


<div class="row">
    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">Add Payment</h3>
                    <small class="text-muted">Payment</small>
                </div>
            </div>

            <div class="card-body">

                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
                            @message
                        </div>
                    }

                    <div class="row g-3">

                        <!-- Payment Name -->
                        <div class="col-md-6">
                            <label class="form-label">Payment Name</label>
                            <InputText class="form-control" @bind-Value="model.name" placeholder="Enter payment name" />
                            <ValidationMessage For="@(() => model.name)" />
                        </div>

                        <!-- Order Id -->
                        <div class="col-md-6">
                            <label class="form-label">Order Id</label>
                            <InputText class="form-control" @bind-Value="model.OrderId" placeholder="Enter order ID" />
                            <ValidationMessage For="@(() => model.OrderId)" />
                        </div>

                        <!-- Transaction Date -->
                        <div class="col-md-6">
                            <label class="form-label">Transaction Date</label>
                            <InputText class="form-control" @bind-Value="model.TransactionDate"
                                       placeholder="Enter transaction date" />
                            <ValidationMessage For="@(() => model.TransactionDate)" />
                        </div>

                        <!-- Tender -->
                        <div class="col-md-6">
                            <label class="form-label">Tender</label>
                            <InputText class="form-control" @bind-Value="model.Tender" placeholder="Enter tender" />
                            <ValidationMessage For="@(() => model.Tender)" />
                        </div>

                        <!-- Store Id -->
                        <div class="col-md-6">
                            <label class="form-label">Store Id</label>
                            <InputText class="form-control" @bind-Value="model.StoreId" placeholder="Enter store ID" />
                            <ValidationMessage For="@(() => model.StoreId)" />
                        </div>

                        <!-- Transaction Amount -->
                        <div class="col-md-6">
                            <label class="form-label">Transaction Amount</label>
                            <InputText class="form-control" @bind-Value="model.TransactionAmount"
                                       placeholder="Enter transaction amount" />
                            <ValidationMessage For="@(() => model.TransactionAmount)" />
                        </div>

                        <!-- Authorization Code -->
                        <div class="col-md-6">
                            <label class="form-label">Authorization Code</label>
                            <InputText class="form-control" @bind-Value="model.AuthorizationCode"
                                       placeholder="Enter authorization code" />
                            <ValidationMessage For="@(() => model.AuthorizationCode)" />
                        </div>

                        <!-- Merchant ID -->
                        <div class="col-md-6">
                            <label class="form-label">Merchant ID</label>
                            <InputText class="form-control" @bind-Value="model.MerchantID"
                                       placeholder="Enter merchant ID" />
                            <ValidationMessage For="@(() => model.MerchantID)" />
                        </div>

                        <div class="col-md-6">
                            @* <div class="d-flex align-items-center" >
                                <div class="form-check"> *@
                            <InputCheckbox class="form-check-input" @bind-Value="model.IsAuthEnable" />
                            <label class="form-check-label">Auth Enable</label>
                            @* </div>
                            </div> *@
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="Cancel">
                            Cancel
                        </button>

                        <button class="btn btn-primary btn-sm" type="submit" disabled="@isLoading">

                            @if (isLoading)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save</span>
                            }

                        </button>
                    </div>

                </EditForm>

            </div>


        </div>
    </div>
</div>
@code {
    private PaymentData model = new();
    private bool isLoading = false;
    private string? message;
    private bool isSuccess;

    private bool showMessage;
    private string messageText = "";
    private string messageClass = "";
    private async Task HandleSubmit()
    {
        isLoading = true;

        try
        {
            var result = await PaymentService.CreateAsync(model);

            isSuccess = result?.success ?? false;
            message = result?.message ?? "No response received";

            if (isSuccess)
            {
                await ShowMessage(
          result!.message ?? "Payment deleted successfully.",
          "alert-success"
      );
                await Task.Delay(1500);
                // optional redirect
                Nav.NavigateTo("/payment/list");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task ShowMessage(string text, string cssClass)
    {
        messageText = text;
        messageClass = cssClass;
        showMessage = true;

        StateHasChanged();

        await Task.Delay(1000);

        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Cancel()
    {
        Nav.NavigateTo("/payment/list");
    }
}