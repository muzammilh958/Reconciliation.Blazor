@page "/payment/list"

@inject IPaymentService PaymentService
@inject NavigationManager Nav
@inject IJSRuntime JsRuntime;

@if (showMessage)
{
    <div class="alert @messageClass alert-dismissible fade show shadow-sm mb-3" role="alert">
        @messageText

        <button type="button" class="btn-close" @onclick="CloseMessage">
        </button>
    </div>
}


<div class="row">
    <div class="col-12">
        <div class="card  shadow-sm">
            @* <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Payment</h4>

                <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 px-3" @onclick="OpenCreate">
                    + New Payment
                </button>
            </div> *@
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">Payment</h3>
                    <small class="text-muted">Manage Payment</small>
                </div>

                <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 px-3" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg"></i>
                       New Payment
                </button>
            </div>


            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <div class="mt-2">Loading Payment...</div>
                    </div>
                }
                else if (hasError)
                {
                    <div class="alert alert-danger">
                        Failed to load Payment.
                    </div>
                }
                else if (Paymentes.Count == 0)
                {
                    <div class="text-center text-muted py-4">
                        No Payment found
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" data-tables="basic">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var Payment in Paymentes)
                                {
                                    <tr>
                                        <td>@Payment.name</td>

                                        
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-primary btn-sm me-1"
                                                    @onclick="() => OpenEdit(Payment)">
                                                Edit
                                            </button>

                                            <button class="btn btn-sm btn-danger"
                                                    @onclick="() => ConfirmDelete(Payment.id, Payment.name)">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
</div>




@code {
    private List<PaymentData> Paymentes = new();
    private bool showDeleteDialog = false;
    private bool showEditDialog = false;
    private PaymentData editModel = new();
    private int selectedPaymentId;
    private string selectedPaymentName = "";
    private IJSObjectReference? _module;

    private bool showMessage;
    private string messageText = "";
    private string messageClass = "";
    private bool isLoading = true;
    private bool hasError = false;
    private bool dataReady = false;

    private async Task InitDataTableAsync()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("loadDataTableAjax");
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;

            Paymentes = await PaymentService.GetAllAsync();

            
            dataReady = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEdit(PaymentData Payment)
    {
        editModel = new PaymentData
        {
            id = Payment.id,
            name = Payment.name
        };

        showEditDialog = true;
    }

    private void CancelEdit()
    {
        showEditDialog = false;
    }

    private async Task LoadPaymentes()
    {
        Paymentes = await PaymentService.GetAllAsync();
        StateHasChanged();
    }
    private void OpenCreate()
    {
        Nav.NavigateTo("/payment/add");
    }

    private void ConfirmDelete(int id, string name)
    {
        selectedPaymentId = id;
        selectedPaymentName = name;
        showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
    }


    private async Task DeletePayment(int PaymentId)
    {
        var result = await PaymentService.DeleteAsync(PaymentId.ToString());

        if (result?.success == true)
        {
            showDeleteDialog = false;
            await LoadPaymentes();

            await ShowMessage(
                result.message ?? "Payment deleted successfully.",
                "alert-success"
            );
        }
        else
        {
            await ShowMessage(
                result?.message ?? "Delete failed.",
                "alert-danger"
            );
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "/css/datatables/datatables-ajax.js"
            );
        }
        if (dataReady && !isLoading && _module != null)
        {
            dataReady = false; // prevent re-run

            await _module.InvokeVoidAsync("initDataTable");
        }
    }

    private async Task UpdatePayment()
    {

        editModel.name = editModel.name?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(editModel.name))
        {
            await ShowMessage(
                "Payment name is required.",
                "alert-danger");
            return;
        }

        var result = await PaymentService.UpdateAsync(editModel.id, editModel);

        showEditDialog = false;

        if (result?.success == true)
        {
            await LoadPaymentes();

            await ShowMessage(
                result.message ?? "Payment updated successfully.",
                "alert-success"
            );

        }
        else
        {

            await ShowMessage(
                result?.message ?? "Failed to update Payment.",
                "alert-danger"
            );
        }
    }

    private async Task ShowMessage(string text, string cssClass)
    {
        messageText = text;
        messageClass = cssClass;
        showMessage = true;

        StateHasChanged();

        await Task.Delay(3000);

        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseMessage()
    {
        showMessage = false;
    }

    
}


@if (showDeleteDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">

        <div class="modal-dialog modal-dialog-centered" style="z-index: 1055;">
            <div class="modal-content shadow">

                <div class="modal-header">
                    <h5 class="modal-title">Delete Payment</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>

                <div class="modal-body py-4">
                    <p class="mb-2">You are about to delete:</p>

                    <div class="alert alert-warning mb-3">
                        <strong>@selectedPaymentName</strong>
                    </div>

                    <small class="text-muted">
                        This action cannot be undone.
                    </small>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">
                        Cancel
                    </button>

                    <button class="btn btn-danger" @onclick="() => DeletePayment(selectedPaymentId)">
                        Yes, delete
                    </button>
                </div>

            </div>
        </div>
    </div>
}
@if (showEditDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">

        <div class="modal-dialog modal-dialog-centered" style="z-index: 1055;">
            <div class="modal-content shadow">

                <div class="modal-header">
                    <h5 class="modal-title">Edit Payment</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>

                <EditForm Model="@editModel" OnValidSubmit="UpdatePayment">
                    <DataAnnotationsValidator />

                    <div class="modal-body py-4">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="editModel.name" />
                        <ValidationMessage For="@(() => editModel.name)" />
                    </div>

                  
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-primary btn-sm">
                            Update
                        </button>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
}