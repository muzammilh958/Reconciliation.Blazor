@page "/dashboard/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@attribute [Authorize]

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>User Profile</h1>
            <hr />

            <AuthorizeView Context="context">
                <Authorized>
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Account Information</h5>
                            <div class="form-group">
                                <label>Username:</label>
                                <p class="form-control-plaintext">@context.User.Identity?.Name</p>
                            </div>

                            <div class="form-group">
                                <label>Email:</label>
                                <p class="form-control-plaintext">@GetUserEmail()</p>
                            </div>

                            <div class="form-group">
                                <label>Roles:</label>
                                <p class="form-control-plaintext">
                                    @if (context.User.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.Role))
                                    {
                                        @string.Join(", ", context.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))
                                    }
                                    else
                                    {
                                        <span>No roles assigned</span>
                                    }
                                </p>
                            </div>

                            <div class="form-group mt-4">
                                <button class="btn btn-warning" @onclick="EditProfile">Edit Profile</button>
                                <button class="btn btn-secondary" @onclick="ChangePassword">Change Password</button>
                            </div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="alert alert-info">
                        Please log in to view your profile.
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Account Actions</h5>
                    <button class="btn btn-link" @onclick="ViewSecuritySettings">Security Settings</button>
                    <br />
                    <button class="btn btn-link" @onclick="ViewNotificationPreferences">Notification Preferences</button>
                    <br />
                    <button class="btn btn-link btn-danger" @onclick="Logout">Logout</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string GetUserEmail()
    {
        // This would typically come from claims
        return "user@example.com";
    }

    private void EditProfile()
    {
        // Implement edit profile logic
    }

    private void ChangePassword()
    {
        // Implement change password logic
    }

    private void ViewSecuritySettings()
    {
        // Implement security settings logic
    }

    private void ViewNotificationPreferences()
    {
        // Implement notification preferences logic
    }

    private async Task Logout()
    {
        // Logout will be handled by a service call
