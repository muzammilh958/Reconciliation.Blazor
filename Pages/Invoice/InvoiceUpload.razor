@page "/invoice/invoice-upload"
@using System.Text.Json

@inject IInvoiceTypeService InvoiceService

@inject IPaymentService PaymentService
@inject IInvoiceService InvoiceServices
@inject IBatchesService BatchesService
@inject IJSRuntime JsRuntime

@inject MenuNavigationService MenuNavigationService
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">@MenuNavigationService.GetMenu()</h3>
                    <small class="text-muted">Import Invoices from POS</small>
                </div>
            </div>

            <div class="card-body">
                @if (showAlert)
                {
                    <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                        @alertMessage
                        <button type="button" class="btn-close" @onclick="() => showAlert = false"></button>
                    </div>
                }
                <div class="row">
                    <div class="col-sm-6">
                        <label class="form-label">Select Batch</label>
                        <select id="batchSelect" class="form-control form-select select2" @bind="SelectedBatchId">
                            <option value="0" disabled>Select Batch</option>
                            @foreach (var batch in batches)
                            {
                                <option value="@batch.id">@batch.name</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label">Select Payment</label>

                        <select id="paymentSelect" class="form-control form-select select2" @bind="SelectedPaymentId">
                            <option value="0" disabled>Select Payment</option>
                            @foreach (var payment in Paymentes)
                            {
                                <option value="@payment.id">@payment.name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-sm-6">
                        <label class="form-label">From Date</label>
                        <input class="form-control" type="date" readonly @bind="FromDate" disabled />
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label">To Date</label>
                        <input class="form-control" type="date" readonly @bind="ToDate" disabled />
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
                        <button class="btn btn-outline-secondary btn-sm" type="button">Cancel</button>

                        <button class="btn btn-primary btn-sm" type="button" @onclick="SaveAsync"
                                disabled="@ispostLoading">
                            @if (ispostLoading)
                            {
                                <span>Importing...</span>
                            }
                            else
                            {

                                <span>Import</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    private bool isLoading = true;
    private bool ispostLoading = false;
    private bool showAlert = false;
    private string alertMessage = "";
    private string alertType = "success";
    private int _selectedInvoiceId = 0;
    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }
    private int _selectedBatchId = 0;

    private List<PaymentData> Paymentes = new();
    private int _selectedPaymentId;
    private List<Models.Batch.BatchDataDTO> batches = new();

    private IJSObjectReference? _module;
    private InvoiceTypeList invoiceType = new();

    private DotNetObjectReference<InvoiceUpload>? _dotNetRef; // TODO: replace "Upload" with your actual @code class name
    private bool _select2Initialized = false;
    protected override void OnInitialized()
    {
        MenuNavigationService.OnMenuChanged += HandleMenuChanged;
    }

    private void HandleMenuChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MenuNavigationService.OnMenuChanged -= HandleMenuChanged;
    }
    private int SelectedInvoiceId
    {
        get => _selectedInvoiceId;
        set
        {
            _selectedInvoiceId = value;
            var invoice = invoiceType.data.FirstOrDefault(x => x.id == value);
            if (invoice != null)
            {
                @* FromDate = Convert.ToDateTime(invoice.FromDate);
                ToDate = Convert.ToDateTime(invoice.ToDate); *@
                StateHasChanged();
            }
        }
    }
    private int SelectedPaymentId
    {
        get => _selectedPaymentId;
        set => _selectedPaymentId = value;
    }

    [JSInvokable]
    public void OnBatchSelected(int batchId)
    {
        SelectedBatchId = batchId; // reuses your existing setter logic (FromDate/ToDate + StateHasChanged)
    }

    [JSInvokable]
    public void OnPaymentSelected(int paymentId)
    {
        SelectedPaymentId = paymentId;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInvoiceSelected(int invoiceId)
    {
        SelectedInvoiceId = invoiceId; // your existing property already does the lookup + StateHasChanged
    }

    private int SelectedBatchId
    {
        get => _selectedBatchId;
        set
        {
            _selectedBatchId = value;
            var batch = batches.FirstOrDefault(x => x.id == value);
            if (batch != null)
            {
                FromDate = Convert.ToDateTime(batch.FromDate);
                ToDate = Convert.ToDateTime(batch.ToDate);
                StateHasChanged();
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/pages/form-fileupload.js");
                await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/merchant-upload.js");
                await JsRuntime.InvokeVoidAsync("loadFormFileUpload");
                await JsRuntime.InvokeVoidAsync("loadConfig");
                await JsRuntime.InvokeVoidAsync("loadApps");

             
            }
            catch (Exception ex)
            {
                Console.WriteLine($"JS load error: {ex.Message}");
            }

            
        }
        if (!_select2Initialized && !isLoading && batches.Any())
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("initMerchantSelect2", _dotNetRef);
            _select2Initialized = true;
        }
    }
    protected override async Task OnInitializedAsync()
    {

        try
        {
            batches = await BatchesService.GetAllAsync();
            invoiceType = await InvoiceService.GetAllAsync();
            Paymentes = await PaymentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            ShowAlert("Failed to load data", "danger");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAlert(string message, string type = "success")
    {
        alertMessage = message;
        alertType = type;
        showAlert = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        ispostLoading = true;

        try
        {


            Console.WriteLine($"SelectedBatchId: {SelectedBatchId}, SelectedPaymentId: {SelectedPaymentId}, FromDate: {FromDate}, ToDate: {ToDate}");

            if (SelectedBatchId <= 0 || SelectedPaymentId <= 0 || !FromDate.HasValue || !ToDate.HasValue)
            {
                ShowAlert("Please fill all required fields", "danger");
                return;
            }

            var model = new InvoiceUploadRequest
            {
                batchId = SelectedBatchId,
                PaymentId = SelectedPaymentId,
                fromDate = FromDate.Value,
                toDate = ToDate.Value
            };

            InvoiceUploadResponse? result = await InvoiceServices.CreateAsync(
                model);

            if (result != null)
            {
                // Directly use the message from the response
                if (!result.success)
                {
                    ShowAlert(result.message ?? "Failed to save", "danger");
                }
                else
                {
                    ShowAlert(result.message ?? "Saved successfully", "success");
                }
            }
            else
            {
                ShowAlert("No response from server", "danger");
            }
        }
        catch (Exception ex)
        {

            ShowAlert(ExtractFriendlyMessage(ex), "danger");
            Console.WriteLine(ex); // full stack trace
        }
        finally
        {
            ispostLoading = false;
        }
    }

    private static string ExtractFriendlyMessage(Exception ex)
    {
        var start = ex.Message.IndexOf('{');
        if (start >= 0)
        {
            try
            {
                var resp = JsonSerializer.Deserialize<InvoiceUploadResponse>(ex.Message[start..]);
                if (resp != null && !string.IsNullOrWhiteSpace(resp.message))
                    return resp.message;
            }
            catch { }
        }
        return "Something went wrong. Please try again.";
    }

    
}
