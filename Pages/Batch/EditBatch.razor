@page "/batch/edit/{Id:int}"
@using global::Reconciliation.Blazor.Models.Batch

@inject IBatchesService BatchesService
@inject NavigationManager Nav

<div class="row">
    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">Edit Batch</h3>
                    <small class="text-muted">Batch</small>
                </div>
            </div>

            <div class="card-body">

                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <div class="mt-2">Loading Batch...</div>
                    </div>
                }
                else if (hasError)
                {
                    <div class="alert alert-danger">
                        Failed to load Batch.
                    </div>
                }
                else
                {
                    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
                                @message
                            </div>
                        }

                        <div class="row g-3">

                            <!-- Name -->
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="model.name" placeholder="Enter batch name" />
                                <ValidationMessage For="@(() => model.name)" />
                            </div>

                            <!-- From Date -->
                            <div class="col-md-6">
                                <label class="form-label">From Date</label>
                                <InputDate class="form-control" @bind-Value="model.FromDate" />
                                <ValidationMessage For="@(() => model.FromDate)" />
                            </div>

                            <!-- To Date -->
                            <div class="col-md-6">
                                <label class="form-label">To Date</label>
                                <InputDate class="form-control" @bind-Value="model.ToDate" />
                                <ValidationMessage For="@(() => model.ToDate)" />
                            </div>

                            <!-- Is Locked -->
                            <div class="col-md-6">
                                <label class="form-label d-block">Is Locked</label>
                                <div class="form-check form-switch fs-lg">
                                    <InputCheckbox id="Is_Locked" class="form-check-input" @bind-Value="model.IsLocked" />
                                </div>
                                <ValidationMessage For="@(() => model.IsLocked)" />
                            </div>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="Cancel">
                                Cancel
                            </button>

                            <button class="btn btn-primary btn-sm" type="submit" disabled="@isSaving">

                                @if (isSaving)
                                {
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Update</span>
                                }

                            </button>
                        </div>

                    </EditForm>
                }

            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private BatchDataDTO model = new();
    private bool isLoading = true;
    private bool hasError = false;
    private bool isSaving = false;
    private string? message;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;

            // NOTE: assumes IBatchesService has a GetByIdAsync(int id) method.
            // Update this call if your service uses a different method name.
            var existing = await BatchesService.GetByIdAsync(Id);

            if (existing is null)
            {
                hasError = true;
            }
            else
            {
                model = new BatchDataDTO
                {
                    id = existing.id,
                    name = existing.name,
                    FromDate = existing.FromDate,
                    ToDate = existing.ToDate,
                    IsLocked = existing.IsLocked
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        model.name = model.name?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(model.name))
        {
            message = "Batch name is required.";
            isSuccess = false;
            isSaving = false;
            return;
        }

        try
        {
            var result = await BatchesService.UpdateAsync(model.id, model);

            isSuccess = result?.success ?? false;
            message = result?.message ?? "No response received";

            if (isSuccess)
            {
                await Task.Delay(1000);
                Nav.NavigateTo("/batch/list");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isSuccess = false;
            message = "Failed to update Batch.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/batch/list");
    }
}
