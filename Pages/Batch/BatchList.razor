@page "/batch/list"
@using Reconciliation.Blazor.Models.Batch

@inject IBatchesService BatchesService
@inject NavigationManager Nav
@inject IJSRuntime JsRuntime;


@if (showMessage)
{
    <div class="alert @messageClass alert-dismissible fade show shadow-sm mb-3" role="alert">
        @messageText

        <button type="button" class="btn-close" @onclick="CloseMessage">
        </button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header justify-content-between">
                <div>
                    <h3 class="mb-0 fw-semibold">Batch</h3>
                    <small class="text-muted">Manage Batch</small>
                </div>

                <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 px-3" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg"></i>
                    New Batch
                </button>
            </div>

            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <div class="mt-2">Loading Batch...</div>
                    </div>
                }
                else if (hasError)
                {
                    <div class="alert alert-danger">
                        Failed to load Batch.
                    </div>
                }
                else if (batches.Count == 0)
                {
                    <div class="text-center text-muted py-4">
                        No Batch found
                    </div>
                }
                else
                {
                    <table class="table table-striped dt-responsive align-middle mb-0" data-tables="basic">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th>Name</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th>Is Lock</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var batch in batches)
                            {
                                <tr>
                                    <td>@batch.name</td>
                                    <td>@(batch.FromDate.HasValue ? batch.FromDate.Value.ToString("yyyy-MM-dd") : "")</td>
                                    <td>@(batch.ToDate.HasValue ? batch.ToDate.Value.ToString("yyyy-MM-dd") : "")</td>

                                    <td>
                                        @if (batch.IsLocked)
                                        {
                                            <span class="badge badge-label badge-soft-danger">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-label badge-soft-success">Unlocked</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary btn-sm me-1" @onclick="() => OpenEdit(batch)">
                                            Edit
                                        </button>

                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => ConfirmDelete(batch.id, batch.name)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>


@code {
    private List<BatchDataDTO> batches = new();
    private bool showDeleteDialog = false;
    @* private bool showEditDialog = false; *@
    private BatchDataDTO editModel = new();
    private int selectedBatchId;
    private string selectedBatchName = "";
    private IJSObjectReference? _module;

    private bool showMessage;
    private string messageText = "";
    private string messageClass = "";
    private bool isLoading = true;
    private bool hasError = false;
    private bool dataReady = false;

    private async Task InitDataTableAsync()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("loadDataTableAjax");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;

            batches = await BatchesService.GetAllAsync();

            dataReady = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenEdit(BatchDataDTO batch)
    {
        Nav.NavigateTo($"/batch/edit/{batch.id}");
       
    }

   
    private async Task LoadBatches()
    {
        batches = await BatchesService.GetAllAsync();
        StateHasChanged();
    }

    private void OpenCreate()
    {
        Nav.NavigateTo("/batches/add");
    }

    private void ConfirmDelete(int id, string name)
    {
        selectedBatchId = id;
        selectedBatchName = name;
        showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
    }

    private async Task DeleteBatch(int batchId)
    {
        var result = await BatchesService.DeleteAsync(batchId.ToString());

        if (result?.success == true)
        {
            showDeleteDialog = false;
            await LoadBatches();

            await ShowMessage(
                result.message ?? "Batch deleted successfully.",
                "alert-success"
            );
        }
        else
        {
            await ShowMessage(
                result?.message ?? "Delete failed.",
                "alert-danger"
            );
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "/css/datatables/datatables-ajax.js"
            );
        }
        if (dataReady && !isLoading && _module != null)
        {
            dataReady = false; // prevent re-run
            await _module.InvokeVoidAsync("initDataTable");
        }
    }

   
    private async Task ShowMessage(string text, string cssClass)
    {
        messageText = text;
        messageClass = cssClass;
        showMessage = true;

        StateHasChanged();

        await Task.Delay(3000);

        showMessage = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseMessage()
    {
        showMessage = false;
    }
}


@if (showDeleteDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered" style="z-index: 1055;">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Batch</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>

                <div class="modal-body py-4">
                    <p class="mb-2">You are about to delete:</p>

                    <div class="alert alert-warning mb-3">
                        <strong>@selectedBatchName</strong>
                    </div>

                    <small class="text-muted">This action cannot be undone.</small>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="() => DeleteBatch(selectedBatchId)">Yes, delete</button>
                </div>
            </div>
        </div>
    </div>
}

