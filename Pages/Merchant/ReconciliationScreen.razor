@page "/merchant/reconciliation"

@inject IBatchesService BatchesService

@inject IPaymentService PaymentService

@inject NavigationManager NavigationManager

@inject IJSRuntime JsRuntime;

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">Reconciliation Wizard</h3>
                    <small class="text-muted">Manage and reconcile batches</small>
                </div>
            </div>
            <div class="card-body">
                @if (showAlert)
                {
                    <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                        @alertMessage
                        <button type="button" class="btn-close" @onclick="() => showAlert = false"></button>
                    </div>
                }

                <!-- Batch selection row (correct) -->
                <div class="row">
                    <div class="col-sm-6">
                        <label class="form-label">Select Batch</label>
                        <select class="form-control form-select select2" id="batchSelect" >
                            <option value="0" selected disabled>Select Batch</option>
                            @foreach (var batch in batchDataDTOs)
                            {
                                <option value="@batch.id">@batch.name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Select Payment</label>
                        <select class="form-control form-select select2" id="paymentSelect" >
                            <option value="0" selected disabled>Select Payment</option>
                            <option value="-1">All Payments (Reconcile All)</option>
                            @foreach (var payment in Paymentes)
                            {
                                <option value="@payment.id">@payment.name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mt-3">
                     <div class="col-sm-6">
                     <label class="form-label">Date Range</label>
                        <div class="input-group">
                            <input type="date" class="form-control" @bind="FromDate" />
                            <span class="input-group-text">to</span>
                            <input type="date" class="form-control" @bind="ToDate" />
                        </div>
                    </div>
                </div>

                @* @if (showResults && reconciliationResult?.data != null)
                {
                    <div class="mt-4">
                        <h5 class="fw-semibold">Reconciliation Results</h5>

                        <div class="row mb-3">
