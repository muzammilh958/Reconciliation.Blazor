@page "/upload/files"

@inject NavigationManager Nav
@inject IJSRuntime JsRuntime;


@inject IMerchantService merchantService


<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
           
         <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">Payment</h3>
                    <small class="text-muted">Upload Payment List</small>
                </div>
            </div>

            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <div class="mt-2">Loading Merchant Upload List...</div>
                    </div>
                }
                else if (hasError)
                {
                    <div class="alert alert-danger">
                        Failed to load Merchant Upload List. Please try again.
                    </div>
                }
                else if (merchantUploadResponse == null || !merchantUploadResponse.data.Any())
                {
                    <div class="text-center text-muted py-4">
                        No Merchant Upload List found
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" data-tables="basic">
                            <thead class="table-light">
                                <tr>
                                    <th>Batch Name</th>
                                    <th>Payment Name</th>
                                    <th>From Date</th>
                                    <th>To Date</th>
                                    <th>Row Count</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var merchantUpload in merchantUploadResponse.data)
                                {
                                    <tr>
                                        <td>@merchantUpload.batch.name</td>
                                        <td>@merchantUpload.payment.name</td>
                                        <td>@merchantUpload.fromDate.ToString("dd/MM/yyyy")</td>
                                        <td>@merchantUpload.toDate.ToString("dd/MM/yyyy")</td>
                                        <td>@merchantUpload.rowCount</td>
                                       
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-success" title="Download Original File"
                                                    @onclick="() => DownloadFile(merchantUpload)">
                                                <i class="ti ti-download me-1"></i>
                                            </button>
                                            
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>



@code {
    // ======================== STATE VARIABLES ========================
    private bool isLoading = false;
    private bool hasError = false;
    private bool dataReady = false;

    private MerchantUploadResponse merchantUploadResponse = new();

    // Detail modal state
    
    private bool isDetailLoading = false;
    private string? detailError;
    private UploadDetail? uploadDetail;
    private string selectedBatchName = "";
    private string selectedPaymentName = "";
    private int selectedUploadId;

    // Search & Pagination
    private string searchTerm = "";
    private int pageSize = 25;
    private int currentPage = 1;
    private IJSObjectReference? _module;

    // ======================== LIFECYCLE ========================
    protected override async Task OnInitializedAsync()
    {
        await LoadStaticData();
    }

    private async Task LoadStaticData()
    {
        try
        {
            isLoading = true;
            hasError = false;
            merchantUploadResponse = await merchantService.GetAllMerchantUploadData();

            dataReady = true;
        }
        catch
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    // ======================== VIEW / DETAIL LOGIC ========================
   
    private async Task InitDataTableAsync()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("loadDataTableAjax");
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "/css/datatables/datatables-ajax.js"
            );
        }
        if (dataReady && !isLoading && _module != null)
        {
            dataReady = false; // prevent re-run

            await _module.InvokeVoidAsync("initDataTable");
        }
    }
    private UploadDetail MapTransactionLinesToUploadDetail(List<TransactionLine> lines)
    {
        var headers = new List<string>
    {
        "Order ID",
        "Store ID",
        "Amount",
        "Tender Type",
        "Auth Code",
        "Transaction Date",
        "Business Day",
        "Recon Status",
        "Exception Type",
        "Variance Amount"
    };

        var rows = new List<UploadDetailRow>();

        foreach (var line in lines)
        {
            var row = new UploadDetailRow();

            // Add a cell for each property
            row.Cells.Add(new UploadDetailCell { Value = line.orderId, HasError = false });
            row.Cells.Add(new UploadDetailCell { Value = line.storeId, HasError = false });
            row.Cells.Add(new UploadDetailCell { Value = line.amount.ToString("F2"), HasError = false });
            row.Cells.Add(new UploadDetailCell { Value = line.tenderType, HasError = false });
            row.Cells.Add(new UploadDetailCell { Value = line.authCode, HasError = false });
            row.Cells.Add(new UploadDetailCell { Value = line.transactionDate.ToString("yyyy-MM-dd HH:mm"), HasError = false });
            row.Cells.Add(new UploadDetailCell { Value = line.businessDay.ToString("yyyy-MM-dd"), HasError = false });
            row.Cells.Add(new UploadDetailCell
            {
                Value = line.varianceAmount?.ToString("F2"),
                HasError = line.varianceAmount != 0
            });

            // Optionally mark row as error if any cell has error
            // but row.HasError is computed from cells automatically in your model

            rows.Add(row);
        }

        return new UploadDetail
        {
            Headers = headers,
            Rows = rows
        };
    }
