<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0 fw-semibold">Users</h3>
                    <small class="text-muted">Manage system users and permissions</small>
                </div>

                <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 px-3" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg"></i>
                    Add User
                </button>
            </div>

            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <div class="mt-2">Loading users...</div>
                    </div>
                }
                else if (hasError)
                {
                    <div class="alert alert-danger">
                        Failed to load users.
                    </div>
                }
                else if (Users.Count == 0)
                {
                    <div class="text-center text-muted py-4">
                        No users found
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" data-tables="basic">
                            <thead class="table-light">
                                <tr>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var user in Users)
                                {
                                    <tr>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>@(user.Roles?.FirstOrDefault() ?? "No Role")</td>
                                        <td>
                                            @if (user.IsLocked)
                                            {
                                                <span class="badge badge-label badge-soft-danger">Locked</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-label badge-soft-success">Active</span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <button class="btn btn-sm btn-primary btn-sm me-1" @onclick="() => OpenEdit(user)">
                                                Edit
                                            </button>

                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(user.Id)">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div> <!-- end card-body-->
        </div> <!-- end card-->

    </div>
</div>

@code {
    private IJSObjectReference? _module;
    private List<UserDto> Users = new();
    private List<RolesDto> AvailableRoles = new();
    private string? SelectedRole;
    private bool isEditModalOpen = false;
    private UserDto editUser = new();
    private bool isLoading = true;
    private bool hasError = false;
    private bool dataReady = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "/css/datatables/datatables-ajax.js"
            );
        }

        // IMPORTANT: run only when DOM is ready
        if (dataReady && !isLoading && _module != null)
        {
            dataReady = false; // prevent re-run

            await _module.InvokeVoidAsync("initDataTable");
        }
    }

    private async Task InitDataTableAsync()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("loadDataTableAjax");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;

            Users = await UserService.GetUsersAsync();
            AvailableRoles = await UserService.GetRolesAsync();

            dataReady = true;
        }
        catch
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

  
    private async Task DeleteUser(Guid userId)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this user?");
        if (confirmed)
        {
            var result = await UserService.DeleteUserAsync(userId);
            if (result)
            {
                Users.RemoveAll(u => u.Id == userId);
                StateHasChanged();
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", "Failed to delete user.");
            }
        }
    }

    private void OpenEdit(UserDto user)
    {
        isLoading = true;
        // clone to avoid direct mutation
        editUser = new UserDto
        {
            Id = user.Id,
            FullName = user.FullName,
            Email = user.Email,
            Roles = user.Roles?.ToList(),
            IsLocked = user.IsLocked
        };
        @* SelectedRole = editUser.Roles?.FirstOrDefault();
         *@
        var roleName = editUser.Roles?.FirstOrDefault();
        SelectedRole = AvailableRoles.FirstOrDefault(r => r.Name == roleName)?.Id;

        isEditModalOpen = true;
        isLoading = false;
    }

    private void CloseEdit()
    {
        isEditModalOpen = false;
    }

    private async Task SaveEdit()
    {
        try
        {
            // Set role from selected role ID
            var selectedRoleName = AvailableRoles.FirstOrDefault(r => r.Id == SelectedRole)?.Name;
            if (!string.IsNullOrEmpty(selectedRoleName))
            {
                editUser.Roles = new List<string> { selectedRoleName };
            }
            else
            {
                editUser.Roles = new List<string>();
            }

            editUser.RoleName = selectedRoleName!;

            // Split full name into first and last name
            var parts = editUser.FullName?.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts != null && parts.Length > 0)
            {
                editUser.FirstName = parts[0];
                editUser.LastName = parts.Length > 1
                    ? string.Join(" ", parts.Skip(1))
                    : string.Empty;
            }

            // Update via API
            var result = await UserService.UpdateUserAsync(editUser);
            Console.WriteLine(result);
            if (result is bool ok && ok)
            {
                isEditModalOpen = false;

                Users = await UserService.GetUsersAsync();

                dataReady = true;
                await InvokeAsync(StateHasChanged);

                @* if (_module != null)
                {
                    await _module.InvokeVoidAsync("reloadDataTable");
                } *@
                // If your service already returns bool, use this
                @* if (boolResult)
                {
                    var index = Users.FindIndex(x => x.Id == editUser.Id);
                    if (index != -1)
                    {
                        Users[index] = editUser;
                    }

                    isEditModalOpen = false;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await JsRuntime.InvokeVoidAsync("alert", "Update failed");
                } *@
            }
        }
        catch (Exception ex)
        {
            // Log the actual error for debugging
            Console.Error.WriteLine($"SaveEdit error: {ex}");
            await JsRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

}
@if (isEditModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button class="btn-close" @onclick="CloseEdit"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label>Full Name</label>
                        <input class="form-control" @bind="editUser.FullName" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input class="form-control" @bind="editUser.Email" />
                    </div>

                    <div class="mb-3">
                        <label>Role</label>
                        <select class="form-select" @bind="SelectedRole">
                            <option value="">-- Select a role --</option>
                            @foreach (var role in AvailableRoles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" @bind="editUser.IsLocked" />
                        <label class="form-check-label">Locked</label>
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEdit">Cancel</button>
                    <button class="btn btn-success" @onclick="SaveEdit">Save</button>
                </div>

            </div>
        </div>
    </div>
}

@code {

    private void OpenCreate()
    {
        Nav.NavigateTo("/users/add");
    }
}